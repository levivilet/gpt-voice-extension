{
  "id": "builtin.gpt-voice",
  "name": "gpt-voice",
  "workerName": "gpt-voice Worker",
  "description": "Browse gpt-voice boards from Lvce Editor",
  "repository": "https://github.com/levivilet/gpt-voice",
  "browser": "dist/gpt-voiceMain.js",
  "isolated": true,
  "contentSecurityPolicy": [
    "default-src 'none'",
    "connect-src https://api.gpt-voice.com https://gpt-voice.com",
    "script-src 'self'"
  ],
  "categories": ["Other"],
  "configuration": {
    "gpt-voice.searchEnabled": {
      "type": "boolean",
      "default": false
    },
    "gpt-voice.boardBackgroundEnabled": {
      "type": "boolean",
      "default": false
    },
    "gpt-voice.cardDetailPopupEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Open card details in a centered popup instead of a right-side panel."
    },
    "gpt-voice.batchRequestsEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Use gpt-voice's batch API for supported read requests."
    }
  },
  "activation": [
    "onView:gpt-voice.views.boards",
    "onCommand:gpt-voice.backToBoards",
    "onCommand:gpt-voice.cancelNewCard",
    "onCommand:gpt-voice.closeBoardFilter",
    "onCommand:gpt-voice.closeCardDetail",
    "onCommand:gpt-voice.logout",
    "onCommand:gpt-voice.openCard",
    "onCommand:gpt-voice.refreshBoards",
    "onCommand:gpt-voice.saveCardDetail",
    "onCommand:gpt-voice.show",
    "onCommand:gpt-voice.startAddCard",
    "onCommand:gpt-voice.submitNewCard",
    "onCommand:gpt-voice.test.useMockData",
    "onCommand:gpt-voice.test.reset",
    "onCommand:gpt-voice.addList",
    "onCommand:gpt-voice.openMockBoard",
    "onCommand:gpt-voice.addCard"
  ],
  "commands": [
    {
      "id": "gpt-voice.show",
      "label": "gpt-voice: Show"
    },
    {
      "id": "gpt-voice.addList",
      "label": "gpt-voice: Add List"
    },
    {
      "id": "gpt-voice.openMockBoard",
      "label": "gpt-voice: Open Mock Board"
    },
    {
      "id": "gpt-voice.addCard",
      "label": "gpt-voice: Add Card"
    },
    {
      "id": "gpt-voice.backToBoards",
      "label": "gpt-voice: Back to Boards"
    },
    {
      "id": "gpt-voice.cancelNewCard",
      "label": "gpt-voice: Cancel New Card"
    },
    {
      "id": "gpt-voice.closeBoardFilter",
      "label": "gpt-voice: Close Board Filter"
    },
    {
      "id": "gpt-voice.closeCardDetail",
      "label": "gpt-voice: Close Card Detail"
    },
    {
      "id": "gpt-voice.logout",
      "label": "gpt-voice: Sign Out"
    },
    {
      "id": "gpt-voice.openCard",
      "label": "gpt-voice: Open Card"
    },
    {
      "id": "gpt-voice.refreshBoards",
      "label": "gpt-voice: Refresh Boards"
    },
    {
      "id": "gpt-voice.saveCardDetail",
      "label": "gpt-voice: Save Card Detail"
    },
    {
      "id": "gpt-voice.startAddCard",
      "label": "gpt-voice: Add Card"
    },
    {
      "id": "gpt-voice.submitNewCard",
      "label": "gpt-voice: Submit New Card"
    },
    {
      "id": "gpt-voice.test.useMockData",
      "label": "gpt-voice Test: Use Mock Data"
    },
    {
      "id": "gpt-voice.test.reset",
      "label": "gpt-voice Test: Reset"
    }
  ],
  "views": [
    {
      "css": "media/gpt-voice.css",
      "displayName": "gpt-voice",
      "id": "gpt-voice.views.boards",
      "title": "gpt-voice",
      "icon": "media/gpt-voice.svg",
      "kind": "virtualDom",
      "preferredLocation": "preview"
    }
  ],
  "keybindings": [
    {
      "key": "Alt+Left",
      "command": "gpt-voice.backToBoards",
      "when": "gpt-voice.boardDetailFocus"
    },
    {
      "key": "Ctrl+R",
      "command": "gpt-voice.refreshBoards",
      "when": "gpt-voice.boardsFocus"
    },
    {
      "key": "Escape",
      "command": "gpt-voice.closeBoardFilter",
      "when": "gpt-voice.boardFilterFocus"
    },
    {
      "key": "Escape",
      "command": "gpt-voice.closeCardDetail",
      "when": "gpt-voice.cardDetailFocus"
    },
    {
      "key": "Enter",
      "command": "gpt-voice.submitNewCard",
      "when": "gpt-voice.newCardInputFocus"
    },
    {
      "key": "Escape",
      "command": "gpt-voice.cancelNewCard",
      "when": "gpt-voice.newCardInputFocus"
    },
    {
      "key": "Ctrl+S",
      "command": "gpt-voice.saveCardDetail",
      "when": "gpt-voice.cardDescriptionFocus"
    }
  ]
}
